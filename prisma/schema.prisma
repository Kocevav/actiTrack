// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  surname     String
  email       String   @unique
  password    String
  dateOfBirth DateTime
  stravaID    String?

  following    User[]   @relation("FollowingRelation", fields: [followingIds], references: [id])
  followingIds String[]
  followers    User[]   @relation("FollowingRelation", fields: [followerIds], references: [id])
  followerIds  String[]

  ownedEvents Event[] @relation("EventOwner")

  eventParticipation EventParticipation[]

  comments Comment[] @relation("CommentOwner")

  activities Activity[] @relation("UserActivities")
}

enum EventStatus {
  CREATED
  FINISHED
}

model Event {
  id          String @id @default(uuid()) @map("_id")
  name        String
  description String

  owner   User   @relation("EventOwner", fields: [ownerId], references: [id])
  ownerId String

  time  DateTime
  place String

  participants EventParticipation[]

  status   EventStatus
  comments Comment[]   @relation("EventComments")
}

model EventParticipation {
  id String @id @default(uuid()) @map("_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
}

model Comment {
  id String @id @default(uuid()) @map("_id")

  owner   User   @relation("CommentOwner", fields: [ownerId], references: [id])
  ownerId String

  toWhoEvent Event  @relation("EventComments", fields: [eventId], references: [id])
  eventId    String

  description String
  rating      Int
}

model Activity {
  id String @id @default(uuid()) @map("_id")

  owner   User   @relation("UserActivities", fields: [ownerId], references: [id])
  ownerId String

  type     String?
  duration Float?
  distance Float?
  date     DateTime?
}
