generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  surname     String
  email       String   @unique
  password    String
  dateOfBirth DateTime
  stravaID    String?

  following    User[]   @relation("FollowingRelation", fields: [followingIds], references: [id])
  followingIds String[]
  followers    User[]   @relation("FollowingRelation", fields: [followerIds], references: [id])
  followerIds  String[]

  ownedEvents Event[] @relation("EventOwner")

  eventParticipation EventParticipation[]

  comments Comment[] @relation("CommentOwner")

  activities Activity[] @relation("UserActivities")
}

enum EventStatus {
  CREATED
  FINISHED
}

model Event {
  id          String @id @default(uuid()) @map("_id")
  name        String
  description String

  owner   User   @relation("EventOwner", fields: [ownerId], references: [id])
  ownerId String

  time  DateTime
  place String

  participants EventParticipation[]

  status   EventStatus
  comments Comment[]   @relation("EventComments")
}

